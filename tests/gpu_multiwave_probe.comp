#version 450
// Runtime mask input prevents a constant-result workload. Workgroups >64
// require shared-memory communication between waves on Liverpool/GFX7.
layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint mode = 0;
layout(set = 0, binding = 0, std430) buffer Result { uint values[]; } result;
shared uint mask;
void main()
{
    uint lane=gl_LocalInvocationIndex;
    if(mode==0) {
        result.values[gl_GlobalInvocationID.x]=gl_GlobalInvocationID.x^0x64a5u;
        return;
    }
    uint seed=result.values[1279];
    if(lane==0)mask=0u;
    barrier();
    if(lane<32 && ((seed>>lane)&1u)!=0)atomicOr(mask,1u<<lane);
    barrier();
    uint remaining=mask,count=0;
    while(remaining!=0u) {remaining&=remaining-1u;count++;}
    result.values[gl_GlobalInvocationID.x]=count;
}
